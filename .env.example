# متغيرات البيئة المطلوبة لتشغيل نظام Villa Marina
# انسخ هذا الملف إلى .env واملأ القيم الفعلية قبل التشغيل

# رابط الاتصال بقاعدة بيانات PostgreSQL (يُستخدم أثناء تشغيل التطبيق)
# مثال محلي (راجع docker-compose.yml):
DATABASE_URL="postgresql://villa_user:villa_pass@localhost:5432/villa_marina?schema=public"

# رابط اتصال مباشر (غير مجمّع) يُستخدم فقط عند تنفيذ ترحيلات قاعدة البيانات.
# محلياً: نفس قيمة DATABASE_URL. على Neon/Supabase: رابط "Direct" من لوحة التحكم،
# بينما DATABASE_URL هو رابط "Pooled".
DIRECT_URL="postgresql://villa_user:villa_pass@localhost:5432/villa_marina?schema=public"

# مفتاح توقيع الجلسات (JWT) - نص عشوائي طويل وسري في بيئة الإنتاج
AUTH_SECRET="change-this-to-a-long-random-secret-in-production"

# العملة المعروضة بجانب المبالغ
CURRENCY_LABEL="د.ل"
